{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "brand-book/**",
              "components/app/**",
              "components/core/**",
              "components/site/**",
              "reference/thorwallet-site/**",
              "reference/thorwallet-site/social/mine-card-16x9/**",
              "reference/thorwallet-site/social/personal/**",
              "reference/thorwallet-site/social/thorwallet-card-16x9/**",
              "reference/thorwallet-site/social/thorwallet-card/**",
              "reference/thorwallet-site/social/thorwallet-swaps/**",
              "reference/thorwallet-site/social/thorwallet/**",
              "reference/thorwallet-site/tests/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:OT Sono|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: OT Sono, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentText'] > JSXAttribute > JSXIdentifier[name!=/^(?:outline|as|children|key|ref|className|style|children)$/]",
        "message": "<AccentText> doesn't accept that prop. Declared props: outline, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppAmountField'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|symbol|iconSrc|balance|fiat|action|style|key|ref|className|style|children)$/]",
        "message": "<AppAmountField> doesn't accept that prop. Declared props: amount, symbol, iconSrc, balance, fiat, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<AppBanner> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success)$/]",
        "message": "<AppBanner> tone must be one of 'info' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|fab|style|key|ref|className|style|children)$/]",
        "message": "<AppBottomNav> doesn't accept that prop. Declared props: active, fab, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:rewards|earn|wallet|perps|card)$/]",
        "message": "<AppBottomNav> active must be one of 'rewards' | 'earn' | 'wallet' | 'perps' | 'card'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<AppButton> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<AppButton> variant must be one of 'primary' | 'ghost'."
